# voxstick — sdkconfig defaults for ESP32-S3 USB UAC.

# --- Target ---------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# --- USB UAC (espressif/usb_device_uac 1.2.x) ----------------------------
# Mic-only: speaker channels = 0 disables host-to-device output stream.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SAMPLE_RATE=16000
# atomic14 found this is the magic switch for macOS to actually pick up the
# mic stream. It breaks Windows enumeration, but we are mac-first.
CONFIG_UAC_SUPPORT_MACOS=y
# Composite UAC + HID — main/ provides tusb_config.h and usb_descriptors.c.
CONFIG_USB_DEVICE_UAC_AS_PART=y

# USB device strings live in main/usb_descriptors.c now — AS_PART hides
# the CONFIG_UAC_TUSB_* knobs.

# --- 8 MB OPI PSRAM (StickS3) --------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Flash ----------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Console: keep USB-Serial/JTAG for logs (separate from UAC USB IF) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- BLE (HID keyboard for presenter and BT dictation; radio stays off until a
#     BLE mode is chosen from the menu) ---
# SM_LVL=2: HID characteristics require an encrypted link. NVS_PERSIST: keep the
# bond across reboots so the host reconnects without re-pairing. Both verified on
# macOS 26 (overnight variant v2).
CONFIG_BT_NIMBLE_SM_LVL=2
# BT REC streams 50 notifications/s; give the host more mbufs than the default 12.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL_DISABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER_DISABLED=y
CONFIG_BT_NIMBLE_HID_SERVICE=y

# A hung task should reset the stick (and show where), not freeze it.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- Wi-Fi + Tailscale (WIFI app, MicroLink in third_party/microlink) -----------------
# Settings from MicroLink's basic_connect example that the tunnel needs: the Noise
# handshake uses ChaCha20-Poly1305 and HKDF, the control plane is HTTPS (TLS 1.2 with
# the common CA bundle), and WireGuard wants a few more lwIP sockets and mailbox slots.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# MicroLink's own web config page would expose the tailnet settings on the VPN address;
# the WIFI app has its own setup hotspot instead.
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
